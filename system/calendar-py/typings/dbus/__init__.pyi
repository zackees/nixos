# dbus-python ships no type information. Method calls are dynamic and return
# `object`, so every result must be narrowed before use.
from collections.abc import Callable, Iterable

class _Proxy:
    def __getattr__(self, name: str) -> Callable[..., object]: ...

class ProxyObject(_Proxy): ...

class Interface(_Proxy):
    def __init__(self, obj: ProxyObject, dbus_interface: str) -> None: ...

class SessionBus:
    def get_name_owner(self, name: str) -> str: ...
    def get_object(self, bus_name: str, object_path: str) -> ProxyObject: ...

class Array(list[object]):
    def __init__(self, items: Iterable[object], signature: str) -> None: ...

class Byte(int): ...
