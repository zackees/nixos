# icalendar 6.3 ships no type information. Declare only what the boundary
# module calls, returning `object` so every value must be narrowed on entry.
from collections.abc import Iterator

class Component:
    def walk(self, name: str) -> list[Component]: ...
    def get(self, key: str) -> object: ...
    def decoded(self, key: str) -> object: ...
    def __contains__(self, key: str) -> bool: ...
    def __iter__(self) -> Iterator[str]: ...
    def add(self, name: str, value: object) -> None: ...
    def add_component(self, component: Component) -> None: ...
    def to_ical(self) -> bytes: ...

class Calendar(Component):
    @classmethod
    def from_ical(cls, st: bytes) -> Calendar: ...

class Event(Component): ...
class Alarm(Component): ...
