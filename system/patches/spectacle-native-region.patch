+QImage ImagePlatformKWin::nativeImageForSelection(const QRectF &rect) const
+{
+    if (rect.isEmpty()) {
+        return {};
+    }
+    for (const auto &image : m_nativeSelectionImages) {
+        const QRectF screenRect{ImageMetaData::logicalXY(image), image.deviceIndependentSize()};
+        if (screenRect.contains(rect)) {
+            return image;
+        }
+    }
+    return {};
+}
